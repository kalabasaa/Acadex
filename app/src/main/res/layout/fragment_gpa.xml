<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ScreenScroll"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout style="@style/ScreenContent" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GPA Calculator"/>

        <TextView style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_lg" android:text="Subject"/>
        <com.student.acadex.DropdownSpinner android:id="@+id/spSubjectFilter" android:layout_width="match_parent" android:layout_height="@dimen/field_height"/>

        <Button android:id="@+id/btnNewCalc" style="@style/Btn" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/gap_md" android:text="+ New calculation"/>

        <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Saved calculations"/>
        <LinearLayout android:id="@+id/calcList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
    </LinearLayout>
</ScrollView>
