<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ScreenScroll"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout style="@style/ScreenContent" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/tvFormTitle" style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add schedule"/>
        <TextView style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_lg" android:text="Subject"/>
        <Spinner android:id="@+id/spSubject" android:layout_width="match_parent" android:layout_height="@dimen/field_height" />
        <TextView style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_lg" android:text="Day"/>
        <Spinner android:id="@+id/spDay" android:layout_width="match_parent" android:layout_height="@dimen/field_height" android:entries="@array/days"/>
        <com.google.android.material.textfield.TextInputLayout 
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_md" android:hint="Start time">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etStart" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="false"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout 
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_md" android:hint="End time">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etEnd" android:layout_width="match_parent" android:layout_height="wrap_content" android:clickable="true" android:focusable="false"/>
        </com.google.android.material.textfield.TextInputLayout>
        <RadioGroup android:id="@+id/rgClassType" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_md" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbOnsite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="Onsite"/>
            <RadioButton android:id="@+id/rbOnline" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/gap_xl" android:text="Online"/>
        </RadioGroup>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilRoom"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_md" android:hint="Room">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etRoom" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilOnline" android:visibility="gone"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_md" android:hint="Link / platform">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etOnline" android:layout_width="match_parent" android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/gap_xl"
            android:orientation="horizontal">
            <Button android:id="@+id/btnCancel" style="@style/BtnOutline" android:layout_width="0dp" android:layout_height="@dimen/button_height" android:layout_weight="1" android:text="Cancel"/>
            <Button android:id="@+id/btnSave" style="@style/Btn" android:layout_width="0dp" android:layout_height="@dimen/button_height" android:layout_marginStart="@dimen/gap_md" android:layout_weight="1" android:text="Save"/>
        </LinearLayout>
        <Button android:id="@+id/btnDelete" style="@style/BtnOutline" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/gap_sm" android:text="Delete" android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
