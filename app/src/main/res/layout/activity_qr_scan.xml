<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/scanner"
        android:layout_width="match_parent" android:layout_height="match_parent"
        app:zxing_preview_scaling_strategy="centerCrop"/>

    <com.student.acadex.ScanGuideView
        android:id="@+id/guide"
        android:layout_width="match_parent" android:layout_height="match_parent"/>

    <Button android:id="@+id/btnClose" style="@style/BtnText"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|start" android:layout_margin="@dimen/gap_md"
        android:textColor="@color/white" android:text="Cancel"/>

    <!-- shown only when the camera permission was denied -->
    <LinearLayout android:id="@+id/deniedPanel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#000000" android:gravity="center" android:orientation="vertical"
        android:padding="@dimen/screen_padding" android:visibility="gone" android:clickable="true" android:focusable="true">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
            android:textColor="@color/white" android:textSize="16sp"
            android:text="Camera access is needed to scan a QR code."/>
        <Button android:id="@+id/btnOpenSettings" style="@style/Btn" android:layout_width="match_parent" android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/gap_xl" android:text="Open app settings"/>
        <Button android:id="@+id/btnDeniedClose" style="@style/BtnOutline" android:layout_width="match_parent" android:layout_height="@dimen/button_height"
            android:layout_marginTop="@dimen/gap_sm" android:textColor="@color/white" android:text="Close"/>
    </LinearLayout>
</FrameLayout>
