<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ScreenScroll"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout style="@style/ScreenContent" android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView style="@style/Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share via QR"/>

        <!-- Share my schedule -->
        <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share your schedule"/>
        <TextView style="@style/Hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pick the subjects to include"/>
        <LinearLayout android:id="@+id/subjectChecklist" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="@dimen/gap_xs"/>
        <Button android:id="@+id/btnGenerate" style="@style/Btn" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/gap_md" android:text="Generate QR"/>

        <com.google.android.material.card.MaterialCardView android:id="@+id/qrCard" style="@style/Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_md" android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:padding="@dimen/card_padding">
                <ImageView android:id="@+id/ivQrResult" android:layout_width="220dp" android:layout_height="220dp" android:contentDescription="Generated QR code"/>
                <Button android:id="@+id/btnShareImage" style="@style/BtnOutline" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:layout_marginTop="@dimen/gap_md" android:text="Share QR code"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Import from a scanned code -->
        <TextView style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Import from a code"/>
        <Button android:id="@+id/btnScan" style="@style/BtnOutline" android:layout_width="match_parent" android:layout_height="@dimen/button_height" android:text="Scan QR code"/>
        <TextView android:id="@+id/tvImportError" style="@style/Sub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/gap_sm" android:textColor="@color/danger" android:visibility="gone"/>

        <LinearLayout android:id="@+id/importPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="@dimen/gap_md" android:visibility="gone"/>

        <LinearLayout android:id="@+id/importActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="@dimen/gap_md" android:visibility="gone">
            <Button android:id="@+id/btnImportCancel" style="@style/BtnOutline" android:layout_width="0dp" android:layout_height="@dimen/button_height" android:layout_weight="1" android:text="Cancel"/>
            <Button android:id="@+id/btnImportConfirm" style="@style/Btn" android:layout_width="0dp" android:layout_height="@dimen/button_height" android:layout_marginStart="@dimen/gap_md" android:layout_weight="1" android:text="Import"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
