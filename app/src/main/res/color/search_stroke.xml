<?xml version="1.0" encoding="utf-8"?>
<!-- Search bar border: blue whether or not it is focused -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/primary" android:state_focused="true"/>
    <item android:color="@color/primary" android:state_hovered="true"/>
    <item android:color="@color/primary"/>
</selector>
