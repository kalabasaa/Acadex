<resources>
    <style name="Theme.Acadex" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/light</item>
        <item name="colorOnPrimaryContainer">@color/dark</item>
        <!-- also the soft blue "glow" behind the active bottom-nav icon -->
        <item name="colorSecondaryContainer">@color/primary_soft</item>
        <item name="colorOnSecondaryContainer">@color/dark</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/black</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- ===== Page layout (same margins/paddings on every page) ===== -->
    <style name="ScreenScroll">
        <item name="android:clipToPadding">false</item>
        <item name="android:scrollbars">none</item>
    </style>
    <style name="ScreenContent">
        <item name="android:orientation">vertical</item>
        <item name="android:paddingLeft">@dimen/screen_padding</item>
        <item name="android:paddingRight">@dimen/screen_padding</item>
        <item name="android:paddingTop">@dimen/screen_padding_top</item>
        <item name="android:paddingBottom">@dimen/screen_padding_bottom</item>
    </style>

    <!-- ===== Cards ===== -->
    <style name="Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/light</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- ===== Text ===== -->
    <style name="Title">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:paddingBottom">@dimen/gap_xs</item>
    </style>
    <style name="Section">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark</item>
        <item name="android:paddingTop">@dimen/gap_xl</item>
        <item name="android:paddingBottom">@dimen/gap_sm</item>
    </style>
    <style name="Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="Sub">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="Hint">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- ===== Buttons ===== -->
    <style name="Btn" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="BtnOutline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/dark</item>
        <item name="android:textColor">@color/dark</item>
    </style>
    <style name="BtnDanger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/danger</item>
        <item name="android:textColor">@color/danger</item>
    </style>
    <style name="BtnText" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/primary</item>
    </style>
    <style name="BtnSmall" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

    <!-- ===== Task row (calendar) ===== -->
    <style name="TaskCode">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dark</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="TaskDate">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="TaskTime">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
    <style name="TaskTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="TaskDesc">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="TaskStatus">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <!-- Speed Dial Labels -->
    <style name="SpeedDialLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:layout_gravity">end</item>
        <item name="android:background">@drawable/bg_speed_dial_label</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/dark</item>
        <item name="android:textStyle">bold</item>
        <item name="android:elevation">0dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
